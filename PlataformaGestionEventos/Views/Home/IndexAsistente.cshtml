@model IEnumerable<PlataformaGestionEventos.Models.Inscripcion>
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .db-card {
        background-color: #21212b;
        border: 1px solid #2d2d3d;
        border-radius: 16px;
        padding: 1.5rem;
        transition: transform 0.2s ease;
    }
    .db-card:hover {
        transform: translateY(-2px);
    }

    .main-banner {
        background: linear-gradient(135deg, #1abc9c, #00bd9d);
        color: #1a1a22;
        min-height: 180px;
        display: flex;
        align-items: center;
    }
    .side-banner {
        background: linear-gradient(135deg, #a855f7, #6366f1);
        color: white;
        min-height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .db-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-bottom: 1rem;
    }

    .icon-evento { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .icon-proximo { background-color: rgba(234, 179, 8, 0.1); color: #eab308; }
    .icon-noti { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }

    .text-muted-custom {
        color: #7e7e8f;
    }
    .db-progress {
        height: 4px;
        background-color: #2d2d3d;
        border-radius: 2px;
        margin-top: 1rem;
    }
    .list-recent-item {
        background-color: #1a1a22;
        border: 1px solid #2d2d3d;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.75rem;
    }
</style>

<div class="container-fluid px-0 w-100 clearfix">

    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-white fw-bold mb-1">Bienvenido, @ViewBag.NombreAsistente!</h2>
            <p class="text-muted-custom small mb-0">Tus eventos, inscripciones y notificaciones en un solo lugar</p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="row g-4">

                <div class="col-12">
                    <div class="db-card main-banner text-dark position-relative overflow-hidden">
                        <div class="py-2">
                            <h4 class="fw-bold mb-2">Explora Nuevos Eventos</h4>
                            <p class="mb-3 opacity-75 small">Revisa los eventos disponibles y regístrate para asegurar tu cupo antes de que se llenen.</p>
                            <a asp-controller="Evento" asp-action="Disponibles" class="btn btn-dark btn-sm rounded-pill px-4 text-white">Ver Disponibles</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="db-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="db-icon-box icon-evento">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                        </div>
                        <h6 class="text-muted-custom mb-1 fw-medium small">Mis Eventos</h6>
                        <h3 class="text-white fw-bold m-0">@ViewBag.TotalMisEventos</h3>
                        <div class="db-progress">
                            <div class="bg-danger h-100" style="width: 70%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="db-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="db-icon-box icon-proximo">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                        <h6 class="text-muted-custom mb-1 fw-medium small">Próximos por Asistir</h6>
                        <h3 class="text-white fw-bold m-0">@ViewBag.TotalProximos</h3>
                        <div class="db-progress">
                            <div class="bg-warning h-100" style="width: 55%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="db-card h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="db-icon-box icon-noti">
                                <i class="bi bi-bell-fill"></i>
                            </div>
                        </div>
                        <h6 class="text-muted-custom mb-1 fw-medium small">Notificaciones sin Leer</h6>
                        <h3 class="text-white fw-bold m-0">@ViewBag.NotificacionesNoLeidas</h3>
                        <div class="db-progress">
                            <div class="bg-primary h-100" style="width: 40%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="db-card">
                        <h5 class="text-white fw-semibold mb-4 fs-6">Resumen de Actividad</h5>
                        <div class="row py-2 text-center text-md-start">
                            <div class="col-md-6 border-end border-secondary border-opacity-25 mb-3 mb-md-0">
                                <div class="d-flex align-items-center justify-content-center justify-content-md-start">
                                    <span class="p-2 bg-info bg-opacity-10 text-info rounded-circle me-3">
                                        <i class="bi bi-calendar2-week fs-4"></i>
                                    </span>
                                    <div>
                                        <h3 class="text-white fw-bold mb-0">@ViewBag.TotalDisponibles</h3>
                                        <p class="text-muted-custom small mb-0">Eventos Disponibles</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center justify-content-center justify-content-md-start ps-0 ps-md-3">
                                    <span class="p-2 bg-success bg-opacity-10 text-success rounded-circle me-3">
                                        <i class="bi bi-envelope-fill fs-4"></i>
                                    </span>
                                    <div>
                                        <h3 class="text-white fw-bold mb-0">@ViewBag.TotalNotificaciones</h3>
                                        <p class="text-muted-custom small mb-0">Notificaciones Totales</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="row g-4">

                <div class="col-12">
                    <div class="db-card side-banner text-center py-4 shadow">
                        <div class="mb-2 opacity-75">
                            <i class="bi bi-bell-fill fs-2"></i>
                        </div>
                        <h5 class="fw-bold mb-1 fs-5">Tienes @ViewBag.NotificacionesNoLeidas notificaciones</h5>
                        <p class="small px-3 mb-3 opacity-75" style="font-size: 0.85rem;">Mantente al tanto de cambios y avisos sobre los eventos en los que estás inscrito.</p>
                        <a asp-controller="Asistente" asp-action="MisNotificaciones" class="btn btn-light rounded-pill px-4 text-dark fw-semibold btn-sm shadow-sm">Ver Notificaciones</a>
                    </div>
                </div>

                <div class="col-12">
                    <div class="db-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-white fw-semibold m-0 small">Mis Próximos Eventos</h6>
                            <i class="bi bi-clock-history text-muted-custom"></i>
                        </div>

                        <div class="d-flex flex-column">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var inscripcion in Model)
                                {
                                    <div class="list-recent-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-bookmark-star text-danger me-3 fs-5"></i>
                                            <div>
                                                <p class="text-white small fw-medium mb-0 text-truncate" style="max-width: 150px;">@inscripcion.Evento?.Nombre</p>
                                                <span class="text-muted-custom text-mini" style="font-size: 0.72rem;">@inscripcion.Evento?.FechaInicio.ToString("dd MMM, HH:mm")</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-dark border border-secondary text-muted-custom rounded-pill" style="font-size: 0.7rem;">@inscripcion.Estado</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted-custom small">
                                    <i class="bi bi-folder-x display-6 d-block mb-2"></i>
                                    Aún no estás inscrito en ningún evento.
                                </div>
                            }
                        </div>

                        <a asp-controller="Evento" asp-action="MisEventos" class="btn btn-outline-light btn-sm w-100 rounded-pill mt-2">Ver todas mis inscripciones</a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
